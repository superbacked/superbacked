{
  "name": "superbacked",
  "productName": "Superbacked",
  "version": "2.0.0-beta.3",
  "description": "Protect what matters most.",
  "main": ".webpack/main/index.js",
  "scripts": {
    "code": "tsx scripts/code.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier '**/*.{json,md,ts,tsx}' --ignore-path .gitignore --write",
    "lint": "eslint",
    "test": "tsx --test --test-reporter spec tests/*.test.ts tests/legacy/*.test.ts",
    "bundle": "npx tsx node_modules/webpack-cli/bin/cli.js --config webpack.main.production.config.ts --config webpack.preload.production.config.ts --config webpack.renderer.production.config.ts",
    "build:darwin:arm64": "electron-builder --config ./builder.config.ts --mac --arm64",
    "build:darwin:x64": "electron-builder --config ./builder.config.ts --mac --x64",
    "build:linux:arm64": "electron-builder --config ./builder.config.ts --linux --arm64",
    "build:linux:x64": "electron-builder --config ./builder.config.ts --linux --x64",
    "build": "npm run bundle && npm run build:darwin:arm64 && npm run build:darwin:x64 && npm run build:linux:arm64 && npm run build:linux:x64",
    "sign-dependencies": "find ./{bin,superbacked-os/*.img,superbacked-os-utilities/sedutil-cli} -type f -print0 | sort -z | xargs -0 shasum --algorithm 256 > SHA256SUMS && gpg --armor --detach-sig --output SHA256SUMS.asc SHA256SUMS",
    "sign-release": "cd dist && find . -name 'superbacked-*' -type f -print0 | sort -z | xargs -0 shasum --algorithm 256 > SHA256SUMS && gpg --armor --detach-sig --output SHA256SUMS.asc SHA256SUMS && cd -",
    "package": "./package.sh",
    "ncu": "ncu --target minor --upgrade"
  },
  "author": {
    "name": "Sun Knudsen",
    "email": "hello@sunknudsen.com"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@svgr/webpack": "^8.1.0",
    "@types/dotenv-webpack": "^7.0.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "css-loader": "^7.1.4",
    "dotenv-webpack": "^8.1.1",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "fs-extra": "^11.4.0",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.8",
    "jpeg-js": "^0.4.4",
    "npm-check-updates": "^19.6.6",
    "prettier": "^3.9.6",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/serialize": "^1.3.3",
    "@emotion/styled": "^11.14.1",
    "@emotion/utils": "^1.4.2",
    "@fontsource/roboto-mono": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/dropzone": "^8.3.18",
    "@mantine/emotion": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@scure/base": "^2.2.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@sunknudsen/totp": "^1.2.0",
    "@tabler/icons-react": "^3.46.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "electron-store": "^8.2.0",
    "leven": "^4.1.0",
    "node-hid": "^3.4.0",
    "pdfjs-dist": "^4.10.38",
    "qr": "^0.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "react-router": "^8.3.0",
    "tar": "^7.5.22"
  },
  "prettier": {
    "endOfLine": "lf",
    "printWidth": 80,
    "semi": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
