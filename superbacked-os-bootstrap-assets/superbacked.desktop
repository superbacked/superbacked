# Same-name shadow of the deb’s stock entry (installed to
# /usr/local/share/applications by the bootstrap), which launches the
# app without a display backend pin.
[Desktop Entry]
Version=1.0
Type=Application
Name=Superbacked
# Pinned to native Wayland via environment (an argv flag would be rejected
# by the app’s commander CLI) — “wayland” hard-selects the backend so the
# passphrase-isolation property fails closed rather than silently falling
# back to a snoopable X11 client.
Exec=env ELECTRON_OZONE_PLATFORM_HINT=wayland /opt/Superbacked/superbacked
# The hicolor icons the deb installs
Icon=superbacked
Terminal=false
# Dock launch feedback — the icon shows a starting state until the first
# window maps (Electron completes the Wayland startup sequence; verified
# on hardware).
StartupNotify=true
